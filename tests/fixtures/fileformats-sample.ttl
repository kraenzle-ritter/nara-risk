  nara:category naraid:DesignVector ;
  nara:formatName "3DS Max" ;
  nara:preservationAction naraid:Transform ;
  nara:preservationPlan "Transform to ESRI ArcGIS Shapefile" ;
  nara:riskLevel naraid:Moderate ;
