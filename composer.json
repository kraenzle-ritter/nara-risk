{
    "name": "kraenzle-ritter/nara-risk-assessment",
    "description": "Laravel package for automated digital preservation risk assessment based on NARA Digital Preservation Framework TTL/RDF data",
    "keywords": [
        "laravel",
        "preservation",
        "nara",
        "digital-preservation",
        "risk-assessment",
        "pronom",
        "file-formats",
        "archival",
        "dpla"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kraenzle-Ritter",
            "email": "info@kraenzle-ritter.ch"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0",
        "pietercolpaert/hardf": "^0.5"
    },
    "require-dev": {
        "laravel/boost": "^1.6",
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^1.12",
        "larastan/larastan": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "KraenzleRitter\\NaraRiskAssessment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KraenzleRitter\\NaraRiskAssessment\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/php-cs-fixer fix",
        "format-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "boost:install": "vendor/bin/testbench workbench:install",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "KraenzleRitter\\NaraRiskAssessment\\NaraServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
